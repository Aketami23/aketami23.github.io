<header class="site-header container">
  <nav aria-label="Main navigation">
    <a href="#about"><span data-lang="en">Research Interests</span><span data-lang="ja">研究分野</span></a>
    <a href="#research"><span data-lang="en">Research</span><span data-lang="ja">研究</span></a>
    <a href="#presentations"><span data-lang="en">Presentations</span><span data-lang="ja">発表</span></a>
    <a href="#experience"><span data-lang="en">Professional Experience</span><span data-lang="ja">職歴</span></a>
    <a href="#background"><span data-lang="en">Education &amp; Activities</span><span data-lang="ja">学歴・活動</span></a>
    <button class="language-switch" type="button" data-language-switch aria-label="Switch language" aria-pressed="false">
      <span data-language-label="en">EN</span><span aria-hidden="true"> / </span><span data-language-label="ja">日本語</span>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const languageSwitch = document.querySelector('[data-language-switch]');

  const setLanguage = (language: 'en' | 'ja') => {
    root.dataset.language = language;
    root.lang = language;
    languageSwitch?.setAttribute('aria-pressed', String(language === 'ja'));
  };

  languageSwitch?.addEventListener('click', () => {
    setLanguage(root.dataset.language === 'ja' ? 'en' : 'ja');
  });

  setLanguage('en');
</script>
