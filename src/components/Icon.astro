---
interface Props {
  name: 'github' | 'orcid' | 'linkedin' | 'university';
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === 'github' && (
    <path
      fill="currentColor"
      d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.77c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
    />
  )}
  {name === 'orcid' && (
    <>
      <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
      <path d="M8.1 10v6M8.1 7.7v.1M11.4 10h1.65a3 3 0 0 1 0 6H11.4v-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="2.5" stroke="currentColor" stroke-width="1.6" />
      <path d="M7.2 10.1V17M7.2 7.2v.1M11 17v-6.9M11 13.05a3.2 3.2 0 0 1 6.4 0V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </>
  )}
  {name === 'university' && (
    <>
      <path d="m3 9.3 9-5.3 9 5.3M4.5 10.5h15M6.5 10.5v7.2M10.2 10.5v7.2M13.8 10.5v7.2M17.5 10.5v7.2M4 20h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </>
  )}
</svg>
