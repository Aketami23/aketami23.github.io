---
import Icon from './Icon.astro';
import LocalizedText from './LocalizedText.astro';
---

<section class="profile-hero container" id="top" aria-label="Affiliation and external profiles">
  <div class="profile-copy">
    <h1><LocalizedText text={{ en: 'Ryo Akiba', ja: '秋葉凌羽' }} /></h1>

    <div class="profile-links" aria-label="External profiles">
      <a href="/ryo-akiba-cv.pdf" target="_blank" rel="noopener noreferrer" aria-label="View CV (PDF, English, opens in a new tab)">
        <span class="profile-link__label"><Icon name="document" /><strong>CV (PDF)</strong></span>
      </a>
      <a href="https://github.com/Aketami23" target="_blank" rel="me noreferrer">
        <span class="profile-link__label"><Icon name="github" /><strong>GitHub</strong></span>
      </a>
      <a href="https://orcid.org/0009-0005-9748-7832" target="_blank" rel="me noreferrer">
        <span class="profile-link__label"><Icon name="orcid" /><strong>ORCID</strong></span>
      </a>
      <a href="https://www.linkedin.com/in/ryo-akiba-30a950417/" target="_blank" rel="me noreferrer">
        <span class="profile-link__label"><Icon name="linkedin" /><strong>LinkedIn</strong></span>
      </a>
    </div>
  </div>
</section>
